#!/usr/bin/env zsh
# tp [query] — pick a git project under $HOME and open/attach a tmux session for it

list_projects() {
  # .git as dir (repos) or file (worktrees); prune dirs that only hold vendored/plugin repos
  find "$HOME" -maxdepth 5 \
    \( -name node_modules -o -name .cache -o -path "$HOME/.tmux" -o -path "$HOME/.local/share/mise" \) -prune -o \
    -name .git -prune -print 2>/dev/null | sed 's|/\.git$||'
}

PROJECT_PATH=$(list_projects | sort -u | fzf --prompt="Select a project: " --height=40% \
  --query="${1:-}" --select-1 --exit-0)

if [[ -z "$PROJECT_PATH" ]]; then
  echo "No project selected."
  exit 0
fi

SESSION_NAME=$(basename "$PROJECT_PATH" | tr '[:upper:]' '[:lower:]' | tr ' .:' '___')

if ! tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
  tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_PATH"
  tmux send-keys -t "$SESSION_NAME:1" "claude" Enter

  tmux new-window -t "$SESSION_NAME" -c "$PROJECT_PATH"
  tmux send-keys -t "$SESSION_NAME:2" "nvim ." Enter

  tmux new-window -t "$SESSION_NAME" -c "$PROJECT_PATH"
  tmux select-window -t "$SESSION_NAME:1"
fi

if [[ -n "$TMUX" ]]; then
  tmux switch-client -t "=$SESSION_NAME"
else
  tmux attach-session -t "=$SESSION_NAME"
fi
