#!/usr/bin/env zsh
# tp [query] — pick a git project under $HOME and open/attach a tmux session for it

list_projects() {
  # .git as dir (repos) or file (worktrees); prune dirs that only hold vendored/plugin repos
  find "$HOME" -maxdepth 5 \
    \( -name node_modules -o -name .cache -o -path "$HOME/.tmux" -o -path "$HOME/.antidote" \
       -o -path "$HOME/.local/share/mise" -o -path "$HOME/.local/share/nvim" \) -prune -o \
    -name .git -prune -print 2>/dev/null | sed 's|/\.git$||'
}

PROJECT_PATH=$(list_projects | sort -u | fzf --prompt="Select a project: " --height=40% \
  --query="${1:-}" --select-1 --exit-0)

if [[ -z "$PROJECT_PATH" ]]; then
  echo "No project selected."
  exit 0
fi

session_name() { print -r -- "${1:l}" | tr ' .:' '___'; }

# Working directory the session was created with (-c)
session_path() { tmux display-message -p -t "=$1" '#{session_path}' 2>/dev/null; }

SESSION_NAME=$(session_name "${PROJECT_PATH:t}")
# Two repos with the same folder name (e.g. ~/work/api and ~/oss/api): if the existing
# session belongs to another path, use parent_repo instead
if tmux has-session -t "=$SESSION_NAME" 2>/dev/null &&
  [[ "$(session_path "$SESSION_NAME")" != "$PROJECT_PATH" ]]; then
  SESSION_NAME=$(session_name "${PROJECT_PATH:h:t}_${PROJECT_PATH:t}")
fi

if ! tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
  tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_PATH"
  tmux send-keys -t "$SESSION_NAME:1" "claude" Enter

  tmux new-window -t "$SESSION_NAME" -c "$PROJECT_PATH"
  tmux send-keys -t "$SESSION_NAME:2" "nvim ." Enter

  tmux new-window -t "$SESSION_NAME" -c "$PROJECT_PATH"
  tmux select-window -t "$SESSION_NAME:1"
fi

if [[ -n "$TMUX" ]]; then
  tmux switch-client -t "=$SESSION_NAME"
else
  tmux attach-session -t "=$SESSION_NAME"
fi
