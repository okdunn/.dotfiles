[include]
  path = ~/.gitconfig.local

[init]
  defaultBranch = main

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[fetch]
  prune = true

[rerere]
  enabled = true

[merge]
  conflictstyle = zdiff3

[diff]
  colorMoved = default
